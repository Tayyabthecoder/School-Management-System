# Database Configuration
MONGODB_URI="mongodb://localhost:27017/sms_dev"
MONGODB_DB_NAME="sms_dev"
REDIS_URL="redis://127.0.0.1:6379"

# Authentication & JWT Configuration
# Development placeholders (>= 32 chars). Production refuses to start with these:
# generate real ones with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev_only_change_me_access_token_secret_0000000000"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_only_change_me_refresh_token_secret_000000000"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# School calendar timezone for weekday rules and "today" views
SCHOOL_TIMEZONE="Asia/Karachi"

# Maximum rows a single report export may contain (larger exports must be filtered)
EXPORT_ROW_LIMIT=10000

# Without Redis each process caches separately; entries live at most this long
MEMORY_CACHE_MAX_TTL_SECONDS=30
