# Used by docker-compose.yml. Copy to .env and replace every value.
# Passwords are placed inside connection URLs: use letters and digits only (or URL-encode them).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_USERNAME=sms_root
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=https://localhost
TLS_COMMON_NAME=localhost
