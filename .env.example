# Used by docker-compose.yml. Copy to .env and replace every value.
# Passwords are placed inside connection URLs: use letters and digits only (or URL-encode them).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_USERNAME=sms_root
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=https://localhost
TLS_COMMON_NAME=localhost

# Only used with the optional docker-compose.dev-ports.yml overlay (publishes MongoDB on 127.0.0.1 for
# local tools); change it if 27017 is already used by a local mongod. The default stack publishes no DB ports.
MONGO_HOST_PORT=27017

# Optional antivirus scanning of uploads. Leave CLAMAV_HOST empty to disable. To enable, set it to
# "clamav" and start the stack with:  docker compose --profile antivirus up -d
CLAMAV_HOST=
CLAMAV_PORT=3310

# Reverse proxies in front of the API that set X-Forwarded-For (bundled nginx = 1). Raise it behind a
# CDN or load balancer (e.g. 2); use 0 only if the API is exposed directly.
TRUST_PROXY_HOPS=1
